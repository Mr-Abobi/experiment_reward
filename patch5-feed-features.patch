+
+/* ---------- Promo card (гости) ---------- */
+.promo-card {
+  margin: 12px 0;
+  padding: 16px 14px;
+  border-radius: 14px;
+  text-align: center;
+  background: linear-gradient(160deg, rgba(201, 168, 76, 0.16), rgba(201, 168, 76, 0.04) 60%);
+  border: 1px solid rgba(201, 168, 76, 0.45);
+  box-shadow: 0 0 24px rgba(201, 168, 76, 0.12);
+}
+.promo-emoji { font-size: 30px; margin-bottom: 6px; }
+.promo-card h4 { margin: 0 0 6px; font-size: 15px; color: #e8e8f0; }
+.promo-card p { margin: 0 0 12px; font-size: 12.5px; line-height: 1.45; color: #a0a0b8; }
+.promo-card .btn-primary { width: 100%; padding: 10px 12px; }
+.promo-sub { margin-top: 10px; font-size: 12px; color: #6b6b80; cursor: pointer; }
+.promo-sub:hover { color: #c9a84c; }
+
+/* ---------- Sorting ---------- */
+.sort-bar {
+  display: flex;
+  gap: 6px;
+  margin-bottom: 16px;
+  flex-wrap: wrap;
+}
+.sort-bar button {
+  background: #16161f;
+  border: 1px solid #2a2a3a;
+  color: #a0a0b8;
+  padding: 7px 14px;
+  border-radius: 20px;
+  font-size: 13px;
+  cursor: pointer;
+  transition: all 0.15s;
+}
+.sort-bar button:hover { border-color: #c9a84c; color: #e8e8f0; }
+.sort-bar button.active {
+  background: rgba(201, 168, 76, 0.15);
+  border-color: #c9a84c;
+  color: #c9a84c;
+  font-weight: 600;
+}
+
+/* ---------- Reactions & comments ---------- */
+.post-actions {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 8px;
+  flex-wrap: wrap;
+  margin-top: 12px;
+  padding-top: 10px;
+  border-top: 1px solid #1f1f2e;
+}
+.react-bar { display: flex; gap: 4px; flex-wrap: wrap; }
+.react-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  background: #1c1c28;
+  border: 1px solid transparent;
+  color: #a0a0b8;
